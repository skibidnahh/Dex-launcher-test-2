<!DOCTYPE html>

<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Test màn hình chính dạng lưới</title>
<style>
  :root {
    color-scheme: dark;
    --cw: 96px;
    --ch: 104px;
    --task: 56px;
    --glass: rgba(24, 30, 48, 0.82);
    --line: rgba(255, 255, 255, 0.14);
    --text: #f2f4fa;
    --text-dim: rgba(242, 244, 250, 0.66);
    --drop: 120, 170, 255;
    --swap: 255, 178, 85;
    --danger: 255, 90, 90;
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body { margin: 0; height: 100%; overflow: hidden; }
  body {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color: var(--text);
    background:
      radial-gradient(ellipse 80% 40% at 50% 100%, rgba(214, 170, 150, .55), rgba(214, 170, 150, 0) 70%),
      linear-gradient(180deg, #02040c 0%, #08153a 32%, #1c3a72 58%, #6b7fa6 80%, #b89d96 100%);
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  button { font: inherit; color: inherit; }
  button:focus-visible, input:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

/* ––––– Màn hình chính ––––– */
#home { position: fixed; left: 0; top: 0; right: 0; bottom: var(–task); }
#gridLayer { position: absolute; inset: 0; opacity: 0; transition: opacity .2s; pointer-events: none; }
body.dragging #gridLayer { opacity: 1; }
.cell {
position: absolute;
width: calc(var(–cw) - 8px);
height: calc(var(–ch) - 8px);
border: 1px dashed rgba(255, 255, 255, .16);
border-radius: 18px;
}
#indicator {
position: absolute;
width: calc(var(–cw) - 8px);
height: calc(var(–ch) - 8px);
left: 0; top: 0;
border-radius: 18px;
border: 2px solid rgba(var(–drop), .95);
background: rgba(var(–drop), .2);
opacity: 0;
transition: transform .12s ease-out, opacity .12s;
pointer-events: none;
}
#indicator.on { opacity: 1; }
#indicator.swap { border-color: rgba(var(–swap), .95); background: rgba(var(–swap), .2); }

/* ––––– Biểu tượng ––––– */
.icon {
position: absolute;
left: 0; top: 0;
width: var(–cw);
height: var(–ch);
display: flex;
flex-direction: column;
align-items: center;
padding-top: 10px;
gap: 7px;
cursor: pointer;
touch-action: none;
transition: transform .3s cubic-bezier(.22, 1, .36, 1);
}
.tile {
width: 54px; height: 54px;
border-radius: 17px;
display: grid; place-items: center;
box-shadow: 0 3px 10px rgba(0, 0, 0, .35), inset 0 1px 0 rgba(255, 255, 255, .25);
}
.tile svg { width: 28px; height: 28px; fill: none; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.label {
max-width: calc(var(–cw) - 10px);
font-size: 12.5px;
line-height: 1.1;
text-align: center;
white-space: nowrap;
overflow: hidden;
text-overflow: ellipsis;
text-shadow: 0 1px 5px rgba(0, 0, 0, .7);
}
.icon.lifted { opacity: 0; transition: none; }
.icon:active .tile { transform: scale(.94); }

.ghost {
position: fixed;
z-index: 100;
pointer-events: none;
transition: none;
will-change: transform, opacity;
transform-origin: 50% 37px;   /* xoay và phóng quanh tâm biểu tượng */
}
.ghost .tile { box-shadow: 0 16px 30px rgba(0, 0, 0, .55), inset 0 1px 0 rgba(255, 255, 255, .25); }

/* ––––– Vùng gỡ ––––– */
#removeZone {
position: fixed;
top: 10px; left: 50%;
width: 210px; height: 46px;
translate: -50% -80px;
border-radius: 23px;
display: grid; place-items: center;
font-size: 14px;
background: rgba(var(–danger), .22);
border: 1px solid rgba(var(–danger), .6);
backdrop-filter: blur(10px);
transition: translate .22s ease, background .15s;
z-index: 50;
pointer-events: none;
}
body.dragging.from-home #removeZone { translate: -50% 0; }
#removeZone.hot { background: rgba(var(–danger), .6); }

/* ––––– Thanh tác vụ ––––– */
#taskbar {
position: fixed;
left: 0; right: 0; bottom: 0;
height: var(–task);
padding: 0 10px 8px;
display: flex;
align-items: flex-end;
justify-content: space-between;
z-index: 30;
}
.bar {
height: 38px;
display: flex; align-items: center; gap: 2px;
padding: 0 4px;
border-radius: 8px;
background: rgba(18, 22, 34, .78);
backdrop-filter: blur(14px);
border: 1px solid rgba(255, 255, 255, .08);
}
.bar button {
width: 34px; height: 30px;
border: 0; border-radius: 6px;
background: none;
display: grid; place-items: center;
cursor: pointer;
}
.bar button:hover, .bar button[aria-expanded=“true”] { background: rgba(255, 255, 255, .14); }
.bar svg { width: 18px; height: 18px; fill: none; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
#clock { padding: 0 12px; font-size: 13px; white-space: nowrap; }

/* ––––– Ngăn ứng dụng ––––– */
#drawer {
position: fixed;
left: 10px;
bottom: calc(var(–task) + 4px);
width: min(540px, calc(100vw - 20px));
height: min(62vh, 440px);
display: flex; flex-direction: column;
background: var(–glass);
backdrop-filter: blur(26px);
border: 1px solid var(–line);
border-radius: 22px;
z-index: 40;
transform-origin: 20px 100%;
transform: scale(.92) translateY(16px);
opacity: 0;
pointer-events: none;
transition: transform .22s ease, opacity .18s ease;
}
#drawer.open { transform: none; opacity: 1; pointer-events: auto; }
body.dragging-from-drawer #drawer { opacity: 0; pointer-events: none; transition: opacity .12s; }
.search { padding: 14px 14px 8px; }
.search input {
width: 100%; height: 40px;
border-radius: 20px;
border: 1px solid var(–line);
background: rgba(255, 255, 255, .08);
color: var(–text);
padding: 0 16px;
font-size: 15px;
}
.search input::placeholder { color: var(–text-dim); }
.scroller {
flex: 1; overflow-y: auto; padding: 4px 8px 12px;
display: grid;
grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
align-content: start;
scrollbar-width: thin;
}
body.dragging-from-drawer .scroller { overflow: hidden; }
.dicon {
position: relative;
display: flex; flex-direction: column; align-items: center;
gap: 7px; padding: 10px 2px;
border-radius: 14px;
cursor: pointer;
touch-action: pan-y;
}
.dicon:hover { background: rgba(255, 255, 255, .07); }
.dicon .label { text-shadow: none; max-width: 84px; }
.dicon .badge {
position: absolute; top: 8px; right: 14px;
width: 8px; height: 8px; border-radius: 50%;
background: #7be28a; box-shadow: 0 0 0 2px rgba(24, 30, 48, .9);
}
.empty { grid-column: 1 / -1; padding: 28px 0; text-align: center; color: var(–text-dim); font-size: 14px; }
.drawer-foot { padding: 8px 16px 12px; font-size: 12px; color: var(–text-dim); border-top: 1px solid var(–line); }

/* ––––– Thông báo nhỏ ––––– */
#toast {
position: fixed;
left: 50%; bottom: calc(var(–task) + 14px);
translate: -50% 20px;
padding: 10px 18px;
border-radius: 20px;
background: rgba(18, 22, 34, .92);
border: 1px solid var(–line);
font-size: 14px;
opacity: 0;
transition: opacity .2s, translate .2s;
pointer-events: none;
z-index: 60;
max-width: 90vw;
text-align: center;
}
#toast.show { opacity: 1; translate: -50% 0; }

@media (prefers-reduced-motion: reduce) {
* { transition-duration: 0s !important; animation-duration: 0s !important; }
}
</style>

</head>
<body>

<main id="home" aria-label="Màn hình chính">
  <div id="gridLayer"></div>
  <div id="indicator"></div>
</main>

<div id="removeZone">Gỡ khỏi màn hình</div>

<section id="drawer" aria-label="Ngăn ứng dụng">
  <div class="search"><input id="search" type="search" placeholder="Tìm ứng dụng" aria-label="Tìm ứng dụng" autocomplete="off"></div>
  <div class="scroller" id="appGrid"></div>
  <div class="drawer-foot">Nhấn giữ một ứng dụng rồi kéo ra màn hình chính. Chấm xanh là ứng dụng đã có trên màn hình.</div>
</section>

<nav id="taskbar">
  <div class="bar">
    <button id="btnApps" aria-label="Mở ngăn ứng dụng" aria-expanded="false">
      <svg viewBox="0 0 24 24"><circle cx="6" cy="6" r="1.3"/><circle cx="12" cy="6" r="1.3"/><circle cx="18" cy="6" r="1.3"/><circle cx="6" cy="12" r="1.3"/><circle cx="12" cy="12" r="1.3"/><circle cx="18" cy="12" r="1.3"/><circle cx="6" cy="18" r="1.3"/><circle cx="12" cy="18" r="1.3"/><circle cx="18" cy="18" r="1.3"/></svg>
    </button>
    <button aria-label="Ứng dụng gần đây"><svg viewBox="0 0 24 24"><path d="M5 9c4-3 7 3 11 0M5 15c4-3 7 3 11 0"/></svg></button>
    <button aria-label="Quay lại"><svg viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="2.5"/></svg></button>
  </div>
  <div class="bar"><span id="clock"></span></div>
</nav>

<div id="toast" role="status" aria-live="polite"></div>

<script>
(() => {
  const $ = (id) => document.getElementById(id);
  const home = $('home'), gridLayer = $('gridLayer'), indicator = $('indicator');
  const drawer = $('drawer'), appGrid = $('appGrid'), btnApps = $('btnApps');
  const removeZone = $('removeZone'), toastEl = $('toast');

  /* ---------- Hằng số lưới ---------- */
  const CW = 96, CH = 104, PX = 10, PY = 14;
  let cols = 1, rows = 1;

  /* ---------- Dữ liệu ứng dụng ---------- */
  const APPS = [
    { id: 'files',    name: 'Tệp của tôi', bg: 'linear-gradient(160deg,#ffbe45,#f08a1c)', d: '<path d="M4 8a2 2 0 0 1 2-2h4l2 2h6a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/>' },
    { id: 'internet', name: 'Internet',    bg: 'linear-gradient(160deg,#7f83ff,#5a4fd6)', d: '<circle cx="12" cy="12" r="8"/><path d="M4 12h16M12 4c3 3 3 13 0 16M12 4c-3 3-3 13 0 16"/>' },
    { id: 'email',    name: 'Email',       bg: 'linear-gradient(160deg,#ff6a55,#e63b3b)', d: '<rect x="4" y="6" width="16" height="12" rx="2"/><path d="M4 8l8 6 8-6"/>' },
    { id: 'gallery',  name: 'Thư viện',    bg: 'linear-gradient(160deg,#ffd23f,#f5a300)', d: '<rect x="4" y="5" width="16" height="14" rx="2"/><circle cx="9" cy="10" r="1.5"/><path d="M5 17l5-5 4 4 2-2 3 3"/>' },
    { id: 'settings', name: 'Cài đặt',     bg: 'linear-gradient(160deg,#78a2ff,#4a6fd8)', d: '<circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/>' },
    { id: 'sheets',   name: 'Sheets',      bg: 'linear-gradient(160deg,#3fbf6d,#1b8f4a)', d: '<rect x="5" y="4" width="14" height="16" rx="2"/><path d="M5 10h14M5 15h14M12 10v10"/>' },
    { id: 'player',   name: 'MX Player',   bg: 'linear-gradient(160deg,#4aa3ff,#2468e0)', d: '<path d="M9 7l8 5-8 5z"/>' },
    { id: 'messenger',name: 'Messenger',   bg: 'linear-gradient(160deg,#35b6ff,#8a4dff)', d: '<path d="M12 4a8 8 0 0 0-8 8c0 2.4 1 4.4 2.7 5.8V21l3-1.7c.7.2 1.5.3 2.3.3a8 8 0 0 0 0-16z"/>' },
    { id: 'music',    name: 'Nhạc',        bg: 'linear-gradient(160deg,#ff7aa8,#d93f78)', d: '<path d="M9 17V6l9-2v11"/><circle cx="7" cy="17" r="2"/><circle cx="16" cy="15" r="2"/>' },
    { id: 'calc',     name: 'Máy tính',    bg: 'linear-gradient(160deg,#6b7a8f,#3f4b5c)', d: '<rect x="5" y="4" width="14" height="16" rx="2"/><path d="M8 8h8M8 12h2M12 12h2M8 16h2M12 16h4"/>' },
    { id: 'calendar', name: 'Lịch',        bg: 'linear-gradient(160deg,#5fd0c4,#1f9e94)', d: '<rect x="4" y="6" width="16" height="14" rx="2"/><path d="M4 11h16M9 4v4M15 4v4"/>' },
    { id: 'camera',   name: 'Máy ảnh',     bg: 'linear-gradient(160deg,#ff8d5c,#e5562a)', d: '<path d="M4 8h3l2-2h6l2 2h3v11H4z"/><circle cx="12" cy="13" r="3.2"/>' },
    { id: 'clock',    name: 'Đồng hồ',     bg: 'linear-gradient(160deg,#9b8cff,#6a55e0)', d: '<circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/>' },
    { id: 'notes',    name: 'Ghi chú',     bg: 'linear-gradient(160deg,#f6d860,#d9aa1f)', d: '<path d="M6 4h9l3 3v13H6z"/><path d="M9 11h6M9 15h6"/>' },
  ];
  const byId = Object.fromEntries(APPS.map((a) => [a.id, a]));

  /* ---------- Trạng thái: id -> {c, r} ---------- */
  const placed = {};
  const homeEls = {};
  ['files', 'internet', 'email', 'gallery', 'settings', 'sheets', 'player'].forEach((id, i) => { placed[id] = { c: 0, r: i }; });

  const occupant = (c, r) => Object.keys(placed).find((id) => placed[id].c === c && placed[id].r === r) || null;

  function freeNear(c, r) {
    let best = null, bestD = Infinity;
    for (let cc = 0; cc < cols; cc++) for (let rr = 0; rr < rows; rr++) {
      if (occupant(cc, rr)) continue;
      const dist = (cc - c) ** 2 + (rr - r) ** 2;
      if (dist < bestD) { bestD = dist; best = { c: cc, r: rr }; }
    }
    return best;
  }

  /* ---------- Tạo biểu tượng ---------- */
  function makeIcon(app, cls) {
    const el = document.createElement('div');
    el.className = cls;
    el.setAttribute('role', 'button');
    el.setAttribute('aria-label', app.name);
    el.innerHTML = `<div class="tile" style="background:${app.bg}"><svg viewBox="0 0 24 24">${app.d}</svg></div><div class="label"></div>`;
    el.querySelector('.label').textContent = app.name;
    return el;
  }

  const posOf = (cell) => `translate(${PX + cell.c * CW}px, ${PY + cell.r * CH}px)`;

  /* ---------- Bố cục & hiển thị ---------- */
  function layout() {
    cols = Math.max(1, Math.floor((home.clientWidth - PX * 2) / CW));
    rows = Math.max(1, Math.floor((home.clientHeight - PY * 2) / CH));

    gridLayer.innerHTML = '';
    for (let c = 0; c < cols; c++) for (let r = 0; r < rows; r++) {
      const cell = document.createElement('div');
      cell.className = 'cell';
      cell.style.transform = `translate(${PX + c * CW + 4}px, ${PY + r * CH + 4}px)`;
      gridLayer.appendChild(cell);
    }

    // đưa các biểu tượng nằm ngoài lưới (khi đổi kích thước cửa sổ) về ô trống gần nhất
    Object.keys(placed).forEach((id) => {
      const p = placed[id];
      if (p.c >= cols || p.r >= rows) {
        delete placed[id];
        const f = freeNear(Math.min(p.c, cols - 1), Math.min(p.r, rows - 1));
        if (f) placed[id] = f;
      }
    });
    render();
  }

  // holdId: icon đang bay vào ô, giữ ẩn bản thật cho tới khi bản "dính tay" hạ cánh xong
  function render(holdId) {
    Object.keys(homeEls).forEach((id) => {
      if (!placed[id]) { homeEls[id].remove(); delete homeEls[id]; }
    });
    Object.keys(placed).forEach((id) => {
      let el = homeEls[id];
      if (!el) {
        el = makeIcon(byId[id], 'icon');
        el.style.transform = posOf(placed[id]);
        home.appendChild(el);
        homeEls[id] = el;
        bindPress(el, byId[id], 'home');
      } else {
        el.style.transform = posOf(placed[id]);
      }
      el.classList.toggle('lifted', id === holdId);
    });
  }

  /* ---------- Ngăn ứng dụng ---------- */
  const norm = (s) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd');

  function renderDrawer() {
    const q = norm($('search').value.trim());
    appGrid.innerHTML = '';
    const list = APPS.filter((a) => norm(a.name).includes(q));
    if (!list.length) {
      appGrid.innerHTML = '<div class="empty">Không tìm thấy ứng dụng nào</div>';
      return;
    }
    list.forEach((app) => {
      const el = makeIcon(app, 'dicon');
      if (placed[app.id]) { const b = document.createElement('i'); b.className = 'badge'; el.appendChild(b); }
      appGrid.appendChild(el);
      bindPress(el, app, 'drawer');
    });
  }

  function setDrawer(open) {
    drawer.classList.toggle('open', open);
    btnApps.setAttribute('aria-expanded', open);
    if (open) { $('search').value = ''; renderDrawer(); }
  }
  btnApps.onclick = () => setDrawer(!drawer.classList.contains('open'));
  $('search').addEventListener('input', renderDrawer);
  document.addEventListener('pointerdown', (e) => {
    if (drag) return;
    if (drawer.classList.contains('open') && !drawer.contains(e.target) && !btnApps.contains(e.target)) setDrawer(false);
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setDrawer(false); });

  /* ---------- Thông báo ---------- */
  let toastTimer;
  function toast(msg, ms = 1800) {
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toastEl.classList.remove('show'), ms);
  }

  /* ---------- Nhấn giữ để nhấc lên ---------- */
  const HOLD_MS = 320, MOVE_TOLERANCE = 10;

  function bindPress(el, app, source) {
    el.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      const start = { x: e.clientX, y: e.clientY };
      let last = { ...start };

      const off = () => {
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('pointerup', onUp);
        window.removeEventListener('pointercancel', off);
      };
      const timer = setTimeout(() => { off(); startDrag(app, source, el, last); }, HOLD_MS);
      const onMove = (ev) => {
        last = { x: ev.clientX, y: ev.clientY };
        if (Math.hypot(last.x - start.x, last.y - start.y) > MOVE_TOLERANCE) { clearTimeout(timer); off(); }
      };
      const onUp = () => { clearTimeout(timer); off(); toast('Mở ' + app.name); };

      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', onUp);
      window.addEventListener('pointercancel', () => { clearTimeout(timer); off(); });
    });
  }

  /* ---------- Kéo thả ---------- */
  let drag = null;
  const DWELL_MS = 110;   // giữ trên một ô bao lâu thì các icon khác mới dạt ra

  // Tính vị trí mới của các icon khác nếu thả icon đang kéo vào ô `target`.
  // Các ô được đánh số theo chiều dọc từng cột (giống cách xếp trong ảnh).
  // Icon nằm giữa ô đích và ô trống gần nhất sẽ dịch sang một ô để nhường chỗ.
  function planFor(excludeId, target) {
    const out = {};
    Object.keys(placed).forEach((id) => { if (id !== excludeId) out[id] = { ...placed[id] }; });
    const total = cols * rows;
    const idxOf = (c, r) => c * rows + r;
    const cellOf = (i) => ({ c: Math.floor(i / rows), r: i % rows });
    const grid = new Array(total).fill(null);
    Object.keys(out).forEach((id) => { grid[idxOf(out[id].c, out[id].r)] = id; });

    if (!target) return { map: out, ok: true };
    const t = idxOf(target.c, target.r);
    if (!grid[t]) return { map: out, ok: true };

    // ưu tiên dồn về phía ô nguồn để cảm giác tự nhiên khi kéo trong cùng màn hình
    const src = placed[excludeId];
    const preferBack = !!src && idxOf(src.c, src.r) < t;
    let e = -1;
    for (let k = 1; k < total && e < 0; k++) {
      const fwd = t + k, back = t - k;
      const order = preferBack ? [back, fwd] : [fwd, back];
      for (const i of order) {
        if (i >= 0 && i < total && !grid[i]) { e = i; break; }
      }
    }
    if (e < 0) return { map: out, ok: false };

    if (e > t) { for (let i = e - 1; i >= t; i--) out[grid[i]] = cellOf(i + 1); }
    else       { for (let i = e + 1; i <= t; i++) out[grid[i]] = cellOf(i - 1); }
    return { map: out, ok: true };
  }

  function setPlan(plan) {
    drag.plan = plan;
    Object.keys(plan.map).forEach((id) => {
      if (homeEls[id]) homeEls[id].style.transform = posOf(plan.map[id]);
    });
  }

  function scheduleReorder(cell) {
    clearTimeout(drag.timer);
    const occupiedByOther = cell && Object.keys(placed).some(
      (id) => id !== drag.app.id && placed[id].c === cell.c && placed[id].r === cell.r
    );
    if (!occupiedByOther) { setPlan(planFor(drag.app.id, null)); return; }
    drag.timer = setTimeout(() => setPlan(planFor(drag.app.id, cell)), DWELL_MS);
  }

  /* ---- Biểu tượng "dính tay": bám theo ngón tay có độ trễ nhẹ, nghiêng theo hướng kéo ---- */
  const TILE_CX = CW / 2, TILE_CY = 37;   // tâm ô biểu tượng bên trong khung CW x CH
  const clamp = (v, lo, hi) => Math.min(hi, Math.max(lo, v));

  function startDrag(app, source, srcEl, pos) {
    const ghost = makeIcon(app, 'icon ghost');
    ghost.style.left = '0px'; ghost.style.top = '0px';
    document.body.appendChild(ghost);

    // điểm ngón tay đang nắm trên biểu tượng: giữ nguyên để icon không bị nhảy về giữa tay
    const tr = srcEl.querySelector('.tile').getBoundingClientRect();
    const grab = {
      x: clamp(pos.x - (tr.left + tr.width / 2), -28, 28),
      y: clamp(pos.y - (tr.top + tr.height / 2), -28, 28),
    };

    drag = {
      app, source, srcEl, ghost, grab,
      pointer: { x: pos.x, y: pos.y },
      cur: { x: tr.left + tr.width / 2 - TILE_CX, y: tr.top + tr.height / 2 - TILE_CY },  // bắt đầu đúng chỗ icon cũ
      tilt: 0, s: 1, sv: 0, o: 1,
      mode: 'hold', land: null,
      cell: null, zone: false, hoverKey: null, timer: null, plan: null,
    };
    if (source === 'home') { srcEl.classList.add('lifted'); document.body.classList.add('from-home'); }
    else document.body.classList.add('dragging-from-drawer');
    document.body.classList.add('dragging');
    if (navigator.vibrate) navigator.vibrate(15);

    moveDrag(pos.x, pos.y);
    window.addEventListener('pointermove', onDragMove);
    window.addEventListener('pointerup', onDragEnd);
    window.addEventListener('pointercancel', onDragCancel);
    requestAnimationFrame(() => animateGhost(drag));
  }

  // Vòng lặp mỗi khung hình: lò xo cho vị trí, độ nghiêng và độ phóng to
  function animateGhost(d) {
    if (!d.ghost) return;
    const prevX = d.cur.x;

    if (d.mode === 'hold') {
      const tx = d.pointer.x - d.grab.x - TILE_CX;
      const ty = d.pointer.y - d.grab.y - TILE_CY;
      d.cur.x += (tx - d.cur.x) * 0.42;
      d.cur.y += (ty - d.cur.y) * 0.42;
      const vx = d.cur.x - prevX;
      d.tilt += (clamp(vx * 1.1, -13, 13) - d.tilt) * 0.2;
      // nảy lên khi vừa nhấc (lò xo quá đà nhẹ rồi ổn định ở 1.16)
      d.sv += (1.16 - d.s) * 0.22; d.sv *= 0.68; d.s += d.sv;
    } else {
      const L = d.land;
      d.cur.x += (L.x - d.cur.x) * 0.26;
      d.cur.y += (L.y - d.cur.y) * 0.26;
      d.tilt += (0 - d.tilt) * 0.3;
      d.s += (L.s - d.s) * 0.26;
      d.o += (L.o - d.o) * 0.3;
    }

    d.ghost.style.transform = `translate3d(${d.cur.x}px, ${d.cur.y}px, 0) rotate(${d.tilt}deg) scale(${d.s})`;
    d.ghost.style.opacity = d.o;

    if (d.mode === 'land') {
      const L = d.land;
      const settled = Math.abs(L.x - d.cur.x) < 0.6 && Math.abs(L.y - d.cur.y) < 0.6 && Math.abs(L.s - d.s) < 0.02;
      if (settled || performance.now() - L.t0 > 600) { endLanding(d); return; }
    }
    requestAnimationFrame(() => animateGhost(d));
  }

  function endLanding(d) {
    d.ghost.remove();
    d.ghost = null;
    if (homeEls[d.app.id]) homeEls[d.app.id].classList.remove('lifted');   // lộ bản thật đúng chỗ ghost vừa đáp
  }

  function moveDrag(x, y) {
    const d = drag;
    d.pointer = { x, y };

    const rect = home.getBoundingClientRect();
    const lx = x - rect.left, ly = y - rect.top;
    const c = Math.floor((lx - PX) / CW), r = Math.floor((ly - PY) / CH);
    const inGrid = lx >= PX && ly >= PY && c >= 0 && r >= 0 && c < cols && r < rows;

    const zr = removeZone.getBoundingClientRect();
    d.zone = d.source === 'home' && x > zr.left - 10 && x < zr.right + 10 && y < zr.bottom + 20;
    removeZone.classList.toggle('hot', d.zone);

    if (inGrid && !d.zone) {
      d.cell = { c, r };
      indicator.style.transform = `translate(${PX + c * CW + 4}px, ${PY + r * CH + 4}px)`;
      indicator.classList.add('on');
    } else {
      d.cell = null;
      indicator.classList.remove('on');
    }

    const key = d.cell ? `${d.cell.c},${d.cell.r}` : 'none';
    if (key !== d.hoverKey) { d.hoverKey = key; scheduleReorder(d.cell); }
  }

  const onDragMove = (e) => moveDrag(e.clientX, e.clientY);

  // gỡ listener, dọn giao diện kéo; ghost vẫn còn để bay vào ô
  function releaseDrag(d) {
    window.removeEventListener('pointermove', onDragMove);
    window.removeEventListener('pointerup', onDragEnd);
    window.removeEventListener('pointercancel', onDragCancel);
    clearTimeout(d.timer);
    document.body.classList.remove('dragging', 'from-home', 'dragging-from-drawer');
    indicator.classList.remove('on');
    removeZone.classList.remove('hot');
  }

  // chọn điểm hạ cánh cho ghost: vào ô, vào vùng gỡ, hoặc thu nhỏ biến mất
  function startLanding(d, kind, cell) {
    const hr = home.getBoundingClientRect();
    if (kind === 'cell') {
      d.land = { x: hr.left + PX + cell.c * CW, y: hr.top + PY + cell.r * CH, s: 1, o: 1 };
    } else if (kind === 'remove') {
      const zr = removeZone.getBoundingClientRect();
      d.land = { x: zr.left + zr.width / 2 - TILE_CX, y: zr.top + zr.height / 2 - TILE_CY, s: 0.2, o: 0 };
    } else {
      d.land = { x: d.cur.x, y: d.cur.y, s: 0.3, o: 0 };
    }
    d.land.t0 = performance.now();
    d.mode = 'land';
  }

  function onDragEnd(e) {
    moveDrag(e.clientX, e.clientY);
    const d = drag;
    const { app, source, cell, zone } = d;
    let kind = 'fade', landCell = null;

    if (zone) {
      delete placed[app.id];
      toast(`Đã gỡ ${app.name} khỏi màn hình`);
      kind = 'remove';
    } else if (cell) {
      const plan = planFor(app.id, cell);   // tính lại cho chắc, phòng khi chưa kịp dạt
      if (plan.ok) {
        Object.keys(placed).forEach((id) => delete placed[id]);
        Object.assign(placed, plan.map);
        placed[app.id] = cell;
        kind = 'cell'; landCell = cell;
      } else {
        toast('Màn hình chính đã đầy');
      }
    }
    // thả ra ngoài lưới: icon từ màn hình chính bay về chỗ cũ
    if (kind === 'fade' && source === 'home' && placed[app.id]) { kind = 'cell'; landCell = placed[app.id]; }

    releaseDrag(d);
    startLanding(d, kind, landCell);
    if (source === 'drawer') setDrawer(false);
    render(kind === 'cell' ? app.id : null);
    if (kind !== 'cell' && d.mode === 'land') { /* ghost tự biến mất ở cuối vòng lặp */ }
    drag = null;
  }

  function onDragCancel() {
    const d = drag;
    releaseDrag(d);
    startLanding(d, d.source === 'home' && placed[d.app.id] ? 'cell' : 'fade', placed[d.app.id]);
    render(d.source === 'home' && placed[d.app.id] ? d.app.id : null);
    drag = null;
  }

  // chặn cuộn / menu chuột phải khi đang kéo
  window.addEventListener('touchmove', (e) => { if (drag) e.preventDefault(); }, { passive: false });
  document.addEventListener('contextmenu', (e) => { if (e.target.closest('.icon, .dicon')) e.preventDefault(); });

  /* ---------- Đồng hồ thanh tác vụ ---------- */
  function tick() {
    $('clock').textContent = new Date().toLocaleString('vi-VN', {
      weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit'
    });
  }
  tick(); setInterval(tick, 15000);

  /* ---------- Khởi động ---------- */
  window.addEventListener('resize', layout);
  layout();
  toast('Nhấn giữ một biểu tượng rồi kéo để đặt vào ô lưới', 4200);
})();
</script>

</body>
